# ============================================================
# METRICMIND DATABASE CONFIGURATION (PostgreSQL)
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metricmind
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ============================================================
# CUBE SEMANTIC LAYER CONFIGURATION
# ============================================================
CUBE_API_URL=http://localhost:4000/cubejs-api/v1/load
CUBE_TIMEOUT_SECONDS=15.0

# ============================================================
# GOOGLE GEMINI AI AGENT CONFIGURATION
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
